{
  "name": "麦田",

  "feishuWebhook": "https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx",

  "pluginDir": "/path/to/obsidian-x-publisher",
  "extensionId": "插件以「加载已解压」安装后，chrome://extensions 里看到的扩展 ID",
  "bridge": "http://127.0.0.1:8765",
  "driver": "direct",
  "chromePort": 9333,
  "chromeProfile": "~/publish-hub/chrome-profile",

  "rootPath": "/Volumes/<NAS 共享名>/视频导出",
  "nasUrl": "smb://<用户名>@<NAS 地址>/<共享名>",

  "batches": [["bilibili", "douyin"], ["xhs", "channels"], ["zsz", "x"], ["youtube"]],
  "auto": ["zsz", "x", "youtube"],
  "manual": ["bilibili", "douyin", "xhs", "channels"],

  "keepAlive": ["channels"],
  "keepAliveMinutes": 60,
  "sampleHours": 6,

  "xHandle": "你的 X 用户名（不带 @）",

  "web": { "port": 8787, "key": "换成一串随机字符，网页访问口令" },

  "site": {
    "name": "知识站",
    "base": "https://your-site.example.com",
    "adminPath": "/admin",
    "coursesApi": "/api/courses?admin=1",
    "dashboardApi": "/api/admin/dashboard",
    "coursePath": "/series/{seriesId}?courseId={id}"
  },

  "board": {
    "url": "飞书多维表格看板地址（可选，不用就删掉 board 整块）",
    "baseToken": "多维表格 base token",
    "tables": { "episodes": "tblxxx", "tasks": "tblxxx", "daily": "tblxxx", "site": "tblxxx", "channels": "tblxxx" }
  }
}
